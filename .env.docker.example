# Docker Environment Configuration Example
# Copy this file to .env and .env.production, then update with your values

# Application
APP_ENV=local
APP_DEBUG=true
APP_NAME="Transport Management System"
APP_KEY=base64:+DYtUAVQQQp3lgoQg8/gNjVccPABc7l1SK9DkP3DH+s=
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tms
DB_USERNAME=tms
DB_PASSWORD=tms_dev_password_change_in_production
DB_ROOT_PASSWORD=root_dev_password_change_in_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache & Session
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Broadcasting (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Transport Management System"

# AWS (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Filesystem
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_VISIBILITY=public

# Features
FEATURE_FLAG_ENABLED=true

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
